<ids:ids xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd" xmlns:ids="http://standards.buildingsmart.org/IDS">
  <!--edited with usBIM.IDSeditor 2.3.20.0 (http://www.accasoftware.com)-->
  <ids:info>
    <ids:title>DRAFT - BEAst Modelleringskrav alá Systemdatamall BIM2BOM</ids:title>
    <ids:copyright>BEAst</ids:copyright>
    <ids:version>0.1</ids:version>
    <ids:description>DRAFT - Informationsleveranskrav baserat på utkast av Systemdatamallar</ids:description>
    <ids:author>projekteringsutskottet@beast.se</ids:author>
    <ids:date>2025-10-27</ids:date>
    <ids:purpose>Framtagen för att ge olika parter som beställare, projektör och entreprenören en gemensam målbild för informationsleveranskraven på IFC-modeller enligt alá systemdatamallar.</ids:purpose>
    <ids:milestone>AP1</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="Samtliga objekt" description="Alla objekt i modellen ska ha ett property set som heter &quot;BIP&quot;. Detta säkerställa enhetlig klassificering och underlättar mängdavtagning och informationsutbyte i projektet." instructions="Kontrollera att varje objekt innehåller property set BIP.&#xA;I Revit skapas och tilldelas dessa genom parameters och user defined propertyset-regler vid IFC-export.&#xA;I Archicad anges de som egenskaper under IFC Property Sets, där BIP måste aktiveras vid export.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:pattern value="IFCBEAM|IFCBUILDINGELEMENTPROXY|IFCCHIMNEY|IFCCOLUMN|IFCCOVERING|IFCCURTAINWALL|IFCDOOR|IFCFOOTING|IFCMEMBER|IFCPILE|IFCPLATE|IFCRAILING|IFCRAMP|IFCRAMPFLIGHT|IFCROOF|IFCSLAB|IFCSTAIR|IFCSTAIRFLIGHT|IFCSHADINGDEVICE|IFCWALL|IFCWALLSTANDARDCASE|IFCWINDOW|IFCBUILTELEMENT" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property cardinality="required">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*" />
            </xs:restriction>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required" instructions="Status of renovation component | Revit: Lägg till parameter 'renovation component status' på Instance. Fyll i 'Ny'/'Befintlig'/'Rivning' eller mappa till Phase Created. | Archicad: Skapa Text-property 'renovation component status' i BIP, fyll i 'Ny'/'Befintlig'/'Rivning'.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>renovation component status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Type name identifier | Revit: Lägg till parameter 'type name id' på Type. Använd som typidentifierare enligt BIP-koder.se (t.ex. 'YVB01', 'F1'). | Archicad: Skapa Text-property 'type name id' i BIP, använd som typidentifierare (t.ex. 'YVB01', 'F1').">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>type name id</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Level eller storey information | Revit: Lägg till parameter 'floor' på Instance. Mappas automatiskt från Level-parameter eller fyll i manuellt. | Archicad: Skapa Text-property 'floor' i BIP, använd expression =HOMESTOREY eller fyll i manuellt.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>floor</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Klassifikationssystem (BSAB 96) | Revit: Lägg till parameter 'BSAB 96' på Type eller Instance. Fyll i BSAB-kod som text (t.ex. '43.C'). | Archicad: Skapa Text-property 'BSAB 96' i BIP, fyll i BSAB-kod som text.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BSAB 96</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="optional" instructions="Batch/Lot nummer för produktspårning (valfritt) | Revit: Lägg till parameter 'LotNumberID' på Type eller Instance. Fyll i batch/lot-nummer som text (t.ex. 'B-2024-001'). | Archicad: Skapa Text-property 'LotNumberID' i BIP, fyll i batch/lot-nummer som text. Används för att gruppera produkter från samma tillverkningssats i Peppol-katalog.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LotNumberID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="MMI-nivå (Modell Mognads Index) | Revit: Lägg till parameter 'MMI' på Type eller Instance. Fyll i tresiffrig MMI-kod (t.ex. '100', '250', '375'). | Archicad: Skapa Text-property 'MMI' i BIP, fyll i tresiffrig MMI-kod (t.ex. '100', '200', '300').">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>MMI</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="\d{3}" />
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="Våningsbenämningar" description="Alla våningar i modellen ska ha grundläggande attribut på varje våning." instructions="Ange Name i tresiffrig kod, Elevation samt Description. ">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Elevation from ground level | Revit: Level Properties &gt; Elevation (höjd från Project Base Point). | Archicad: Story Settings &gt; Elevation (höjd fran marknivå).">
          <ids:name>
            <ids:simpleValue>Elevation</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Storey number (000, 010, 020, 025, etc.) | Revit: Level Name - använd 3-siffrig kod (000, 010, 020). | Archicad: Story Settings &gt; Name = 3-siffrig kod (000, 010, 020).">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="\d{3}" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Våningsbeskrivning. Plan 0 (Krypgrund), Plan 1 (Garage), Plan 2 (Entré), Plan 2 (Halvplan) osv. | Revit: Lägg till Shared Parameter kallad &quot;IfcDescription&quot;, finns i filen som kallas &quot;IFC Shared Parameters.txt&quot; som Autodesk tillhandahåller, lägg denna egenskap på Level och fyll i egenskapen. | Archicad: Story Settings &gt; Description.">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="Byggdelar - Yttervägg" description="Alla ytterväggar ska innehålla specificerade egenskaper från BIP property set för att möjliggöra korrekt mängdavtagning för BIM2BOM." instructions="Kontrollera att varje ytterväggar innehåller alla obligatoriska egenskaper i BIP property set.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCWALL</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>is external</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>true</ids:simpleValue>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Typbeteckning (YVB01 for bearing, YV01 for non-bearing) | Revit: Lägg till parameter 'TypeID' på Type. Använd som typdefinition (t.ex. 'YVB01' bärande, 'YV01' ej bärande). Kan mappas från Type Mark. | Archicad: Skapa Text-property 'TypeID' i BIP (t.ex. 'YVB01' bärande, 'YV01' ej bärande).">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>type name id</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required" instructions="Typbeskrivning | Revit: Lägg till parameter 'TypeDescription' på Type. Kan mappas från Type Comments. | Archicad: Skapa Text-property 'TypeDescription' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeDescription</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Klassifikationssystem (BSAB 96) | Revit: Lägg till parameter 'BSAB 96' på Type eller Instance. Fyll i BSAB-kod som text (t.ex. 'NBC'), INTE classification system. | Archicad: Skapa Text-property 'BSAB 96' i BIP, fyll i BSAB-kod som text (t.ex. 'NBC'), INTE classification system.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BSAB 96</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required" instructions="Material | Revit: Lägg till parameter 'materials/components' på Type. Lista material/lager från elementets struktur. | Archicad: Skapa Text-property 'materials/components' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>materials/components</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required" instructions="Höjd | Revit: Lägg till parameter 'height' på Instance. För Walls: från Unconnected Height eller Length. För Doors/Windows: från Height-parameter i Type Properties. För Columns: från Length. | Archicad: Skapa Number-property 'height' i BIP, använd expression =ZZYZX.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>height</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required" instructions="Längd | Revit: Lägg till parameter 'length' på Instance. För Walls: mappas från Length-parameter. För Beams: från Length-parameter i Properties. | Archicad: Skapa Number-property 'length' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>length</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required" instructions="Tjocklek | Revit: Lägg till parameter 'thickness' på Type. För Walls: Kan mappas från Width-parameter. | Archicad: Skapa Number-property 'thickness' i BIP, använd expression =B.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>thickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" cardinality="optional" instructions="Bruttoarea (inkl. öppningar) | Revit: Lägg till parameter 'gross area' på Instance. För Walls: använd Area-parameter. För Floors/Roofs/Ceilings: mappas från Area-parameter automatiskt. | Archicad: Skapa Number-property 'gross area' i BIP, använd expression =AREA_GROSS.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>gross area</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" cardinality="required" instructions="Nettoarea (exkl. öppningar) | Revit: Lägg till parameter 'net area' på Instance. Beräknas som Gross Area minus öppningar. | Archicad: Skapa Number-property 'net area' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>net area</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCVOLUMEMEASURE" cardinality="optional" instructions="Bruttovolym (inkl. öppningar) | Revit: Lägg till parameter 'gross volume' på Instance. För Walls: mappas från Volume-parameter automatiskt. | Archicad: Skapa Number-property 'gross volume' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>gross volume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCVOLUMEMEASURE" cardinality="required" instructions="Nettovolym | Revit: Lägg till parameter 'net volume' på Instance. Kan användas för netto-volym beräkning. | Archicad: Skapa Number-property 'net volume' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>net volume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCREAL" cardinality="required" instructions="Vikt | Revit: Lägg till parameter 'weight' på Instance. Kan beräknas från Volume × Material Density eller hämtas från schedule. | Archicad: Skapa Number-property 'weight' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>weight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" cardinality="required" instructions="Bärande | Revit: Lägg till parameter 'is load bearing' på Type eller Instance. För Walls: kan mappas från Structural-parameter (Wall Properties). | Archicad: Skapa Yes/No-property 'is load bearing' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>is load bearing</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Våningsplan | Revit: Lägg till parameter 'floor' på Instance. Mappas automatiskt från Level-parameter eller fyll i manuellt. | Archicad: Skapa Text-property 'floor' i BIP, använd expression =HOMESTOREY eller fyll i manuellt.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>floor</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Byggnadsstatus | Revit: Lägg till parameter 'renovation component status' på Instance. Fyll i 'Ny'/'Befintlig'/'Rivning' eller mappa till Phase Created/Phase Demolished. | Archicad: Skapa Text-property 'renovation component status' i BIP, fyll i 'Ny'/'Befintlig'/'Rivning'.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>renovation component status</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" cardinality="required" instructions="Bärande | Revit: Lägg till parameter 'is external' på Type eller Instance. För Walls: kan mappas från Structural-parameter (Wall Properties). | Archicad: Skapa Yes/No-property 'is external' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>is external</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="Byggdelar - Innervägg" description="Alla innerväggar ska innehålla specificerade egenskaper från BIP property set för att möjliggöra korrekt mängdavtagning för BIM2BOM." instructions="Kontrollera att varje innerväggar innehåller alla obligatoriska egenskaper i BIP property set.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCWALL</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:property dataType="IFCBOOLEAN">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>is external</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>false</ids:simpleValue>
          </ids:value>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Typbeteckning (YVB01 for bearing, YV01 for non-bearing) | Revit: Lägg till parameter 'TypeID' på Type. Använd som typdefinition (t.ex. 'YVB01' bärande, 'YV01' ej bärande). Kan mappas från Type Mark. | Archicad: Skapa Text-property 'TypeID' i BIP (t.ex. 'YVB01' bärande, 'YV01' ej bärande).">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>type name id</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required" instructions="Typbeskrivning | Revit: Lägg till parameter 'TypeDescription' på Type. Kan mappas från Type Comments. | Archicad: Skapa Text-property 'TypeDescription' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>TypeDescription</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" cardinality="required" instructions="Klassifikationssystem (BSAB 96) | Revit: Lägg till parameter 'BSAB 96' på Type eller Instance. Fyll i BSAB-kod som text (t.ex. 'NBC'), INTE classification system. | Archicad: Skapa Text-property 'BSAB 96' i BIP, fyll i BSAB-kod som text (t.ex. 'NBC'), INTE classification system.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>BSAB 96</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCTEXT" cardinality="required" instructions="Material | Revit: Lägg till parameter 'materials/components' på Type. Lista material/lager från elementets struktur. | Archicad: Skapa Text-property 'materials/components' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>materials/components</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required" instructions="Höjd | Revit: Lägg till parameter 'height' på Instance. För Walls: från Unconnected Height eller Length. För Doors/Windows: från Height-parameter i Type Properties. För Columns: från Length. | Archicad: Skapa Number-property 'height' i BIP, använd expression =ZZYZX.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>height</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required" instructions="Längd | Revit: Lägg till parameter 'length' på Instance. För Walls: mappas från Length-parameter. För Beams: från Length-parameter i Properties. | Archicad: Skapa Number-property 'length' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>length</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required" instructions="Tjocklek | Revit: Lägg till parameter 'thickness' på Type. För Walls: Kan mappas från Width-parameter. | Archicad: Skapa Number-property 'thickness' i BIP, använd expression =B.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>thickness</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" cardinality="optional" instructions="Bruttoarea (inkl. öppningar) | Revit: Lägg till parameter 'gross area' på Instance. För Walls: använd Area-parameter. För Floors/Roofs/Ceilings: mappas från Area-parameter automatiskt. | Archicad: Skapa Number-property 'gross area' i BIP, använd expression =AREA_GROSS.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>gross area</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" cardinality="required" instructions="Nettoarea (exkl. öppningar) | Revit: Lägg till parameter 'net area' på Instance. Beräknas som Gross Area minus öppningar. | Archicad: Skapa Number-property 'net area' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>net area</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCVOLUMEMEASURE" cardinality="optional" instructions="Bruttovolym (inkl. öppningar) | Revit: Lägg till parameter 'gross volume' på Instance. För Walls: mappas från Volume-parameter automatiskt. | Archicad: Skapa Number-property 'gross volume' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>gross volume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCVOLUMEMEASURE" cardinality="required" instructions="Nettovolym | Revit: Lägg till parameter 'net volume' på Instance. Kan användas för netto-volym beräkning. | Archicad: Skapa Number-property 'net volume' i BIP.">
          <ids:propertySet>
            <ids:simpleValue>BIP</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>net volume</ids:simpleValue>
          </ids:baseName>
        </ids:property>
