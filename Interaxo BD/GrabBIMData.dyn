{
  "Uuid": "a7c8076e-03fe-46d5-9223-3427a52a146d",
  "IsCustomNode": false,
  "Description": "",
  "Name": "GrabBIMData",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nimport json\r\nimport ssl\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nprojectGuid = IN[0]\r\naccess_token = IN[1]\r\ntypeId = IN[2] if len(IN) > 2 and IN[2] is not None else 100\r\n\r\ncategories = IN[3] if len(IN) > 3 and IN[3] is not None else []\r\nmodels = IN[4] if len(IN) > 4 and IN[4] is not None else []\r\nstates = IN[5] if len(IN) > 5 and IN[5] is not None else []\r\nlevels = IN[6] if len(IN) > 6 and IN[6] is not None else []\r\nphases = IN[7] if len(IN) > 7 and IN[7] is not None else []\r\n\r\nbaseUrl = IN[8] if len(IN) > 8 and IN[8] is not None else \"app.bimeye.com\"\r\nelements = IN[9] if len(IN) > 9 and IN[9] is not None else None\r\n\r\nctx = ssl.create_default_context()\r\n\r\n\r\ndef _request_json(method, url, payload=None):\r\n    data = None\r\n    headers = {\r\n        \"content-type\": \"application/json\",\r\n        \"authorization\": access_token,\r\n        \"accept\": \"application/json\",\r\n    }\r\n\r\n    if payload is not None:\r\n        data = json.dumps(payload).encode(\"utf-8\")\r\n\r\n    req = urllib.request.Request(url, data=data, method=method)\r\n    for k, v in headers.items():\r\n        req.add_header(k, v)\r\n\r\n    try:\r\n        with urllib.request.urlopen(req, context=ctx, timeout=60) as r:\r\n            body = r.read().decode(\"utf-8\", errors=\"replace\")\r\n            return json.loads(body)\r\n    except urllib.error.HTTPError as e:\r\n        body = e.read().decode(\"utf-8\", errors=\"replace\")\r\n        raise Exception(\"HTTP {} {} {}\".format(e.code, url, body))\r\n\r\n\r\ndef getParameters():\r\n    url = \"https://{}/services/bim/v1/project/{}/parameter\".format(baseUrl, projectGuid)\r\n    res = _request_json(\"GET\", url)\r\n    return res.get(\"result\", [])\r\n\r\n\r\ndef getMasterParameterNames():\r\n    url = (\r\n        \"https://{}/services/bim/v1/project/{}/parameter\"\r\n        \"?search[typeId]={}&search[relation]=masterParameter\"\r\n    ).format(baseUrl, projectGuid, typeId)\r\n    res = _request_json(\"GET\", url)\r\n    items = res.get(\"result\", []) or []\r\n    return [p.get(\"name\") for p in items if isinstance(p, dict) and p.get(\"name\")]\r\n\r\n\r\ndef getWorktableCount(payload):\r\n    url = \"https://{}/services/bim/v1/project/{}/worktable/count?search%5BtypeId%5D={}\".format(\r\n        baseUrl, projectGuid, typeId\r\n    )\r\n    res = _request_json(\"POST\", url, payload)\r\n    return int(res.get(\"result\", {}).get(\"count\", 0))\r\n\r\n\r\ndef getWorktablePage(payload, limit, skip):\r\n    url = (\r\n        \"https://{}/services/bim/v1/project/{}/worktable\"\r\n        \"?search%5BtypeId%5D={}&limit={}&skip={}\"\r\n    ).format(baseUrl, projectGuid, typeId, limit, skip)\r\n    res = _request_json(\"POST\", url, payload)\r\n    return res.get(\"result\", []) or []\r\n\r\n\r\npayload = {\r\n    \"categories\": categories,\r\n    \"models\": models,\r\n    \"states\": states,\r\n    \"levels\": levels,\r\n    \"phases\": phases,\r\n}\r\n\r\nparameters = getParameters()\r\nparam_lookup = {}\r\nfor p in parameters:\r\n    if isinstance(p, dict) and \"id\" in p:\r\n        param_lookup[p[\"id\"]] = p\r\n\r\nheaders = getMasterParameterNames()\r\nif 'GlobalId' not in headers:\r\n    headers.append('GlobalId')\r\nif 'MMI' not in headers:\r\n    headers.append('MMI')\r\n\r\nheader_row = {h: None for h in headers}\r\nheader_lower_to_key = {str(k).lower(): k for k in header_row.keys()}\r\n\r\ncount = getWorktableCount(payload)\r\nlimit = 1000\r\nskip = 0\r\n\r\nrows = []\r\nwhile skip < count:\r\n    page = getWorktablePage(payload, limit, skip)\r\n    for row in page:\r\n        rowData = dict(header_row)\r\n        props = row.get(\"property\", []) if isinstance(row, dict) else []\r\n        for prop in props:\r\n            pid = prop.get(\"parameterId\") if isinstance(prop, dict) else None\r\n            if pid in param_lookup:\r\n                name = param_lookup[pid].get(\"name\")\r\n                if name is None:\r\n                    continue\r\n                key = header_lower_to_key.get(str(name).lower())\r\n                if key is not None:\r\n                    rowData[key] = prop.get(\"value\")\r\n        rows.append(rowData)\r\n\r\n    skip += limit\r\n    if skip > count:\r\n        skip = count\r\n\r\n\r\ndef _lookup_param(el, names):\r\n    for n in names:\r\n        try:\r\n            p = el.LookupParameter(n)\r\n        except Exception:\r\n            p = None\r\n        if p is not None:\r\n            return p\r\n    return None\r\n\r\n\r\nmmi_by_globalid = {}\r\nfor r in rows:\r\n    if not isinstance(r, dict):\r\n        continue\r\n    gid = r.get('GlobalId')\r\n    if gid is None:\r\n        continue\r\n    mmi_by_globalid[str(gid)] = r.get('MMI')\r\n\r\nupdate = {'attempted': 0, 'updated': 0, 'not_found': 0, 'missing_params': 0, 'errors': 0}\r\nupdate_errors = []\r\n\r\nif elements is not None:\r\n    try:\r\n        clr.AddReference('RevitServices')\r\n        from RevitServices.Persistence import DocumentManager\r\n        from RevitServices.Transactions import TransactionManager\r\n\r\n        clr.AddReference('RevitAPI')\r\n        from Autodesk.Revit.DB import StorageType\r\n\r\n        try:\r\n            clr.AddReference('RevitNodes')\r\n            import Revit\r\n            clr.ImportExtensions(Revit.Elements)\r\n            unwrap = UnwrapElement\r\n        except Exception:\r\n            def unwrap(x):\r\n                return x\r\n\r\n        doc = DocumentManager.Instance.CurrentDBDocument\r\n        els = elements\r\n        if not isinstance(els, list):\r\n            els = [els]\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n        for el in els:\r\n            update['attempted'] += 1\r\n            try:\r\n                revit_el = unwrap(el)\r\n                if revit_el is None:\r\n                    update['errors'] += 1\r\n                    update_errors.append('UnwrapElement returned None')\r\n                    continue\r\n\r\n                gid_param = _lookup_param(revit_el, ['GlobalId', 'GlobalID', 'IFC GUID', 'IfcGUID', 'Ifc Guid', 'IFC Guid'])\r\n                mmi_param = _lookup_param(revit_el, ['MMI'])\r\n                if gid_param is None or mmi_param is None:\r\n                    update['missing_params'] += 1\r\n                    continue\r\n\r\n                gid_val = gid_param.AsString()\r\n                if gid_val is None:\r\n                    gid_val = gid_param.AsValueString()\r\n                if not gid_val:\r\n                    update['not_found'] += 1\r\n                    continue\r\n\r\n                if gid_val not in mmi_by_globalid:\r\n                    update['not_found'] += 1\r\n                    continue\r\n\r\n                mmi_val = mmi_by_globalid[gid_val]\r\n                st = mmi_param.StorageType\r\n                if st == StorageType.String:\r\n                    mmi_param.Set('' if mmi_val is None else str(mmi_val))\r\n                elif st == StorageType.Double:\r\n                    mmi_param.Set(0.0 if mmi_val is None or mmi_val == '' else float(mmi_val))\r\n                elif st == StorageType.Integer:\r\n                    mmi_param.Set(0 if mmi_val is None or mmi_val == '' else int(float(mmi_val)))\r\n                else:\r\n                    mmi_param.Set('' if mmi_val is None else str(mmi_val))\r\n\r\n                update['updated'] += 1\r\n            except Exception as e:\r\n                update['errors'] += 1\r\n                update_errors.append(str(e))\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n    except Exception as e:\r\n        update = {'attempted': 0, 'updated': 0, 'not_found': 0, 'missing_params': 0, 'errors': 1}\r\n        update_errors = [str(e)]\r\n\r\ntable = [headers] + [[r.get(h) for h in headers] for r in rows]\r\nmeta = {'count': count, 'headers': len(headers), 'update': update, 'updateErrors': update_errors, 'mmiKeys': len(mmi_by_globalid)}\r\nOUT = (rows, table, meta)\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "38484b96c9ec4bfbbdbb05eedd89e3c8",
