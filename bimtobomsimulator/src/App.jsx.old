import { useEffect, useRef } from "react";
import * as OBC from "@thatopen/components";

export default function App() {
  const containerRef = useRef(null);
  const componentsRef = useRef(null);

  useEffect(() => {
    if (!containerRef.current) return;

    let cancelled = false;
    let rafId = null;

    const logFetch = async (url, label) => {
      try {
        const res = await fetch(url, { method: "HEAD" });
        console.info(`[${label}]`, url, {
          ok: res.ok,
          status: res.status,
          contentType: res.headers.get("content-type"),
          contentLength: res.headers.get("content-length"),
        });
        return res;
      } catch (e) {
        console.warn(`[${label}] HEAD failed`, url, e);
        return null;
      }
    };

    // --- CREATE COMPONENT SYSTEM ---
    const components = new OBC.Components();
    componentsRef.current = components;

    // --- CREATE WORLD ---
    const worlds = components.get(OBC.Worlds);
    const world = worlds.create();

    // Scene
    world.scene = new OBC.SimpleScene(components);

    // Renderer
    world.renderer = new OBC.SimpleRenderer(components, containerRef.current);

    // Camera
    world.camera = new OBC.SimpleCamera(components);

    // Init all components
    components.init();

    // Scene setup (lights, etc)
    world.scene.setup();

    // --- OPTIONAL UTILITIES ---
    const fragments = components.get(OBC.FragmentsManager);
    // Required: Fragments run in a worker
    const fragmentsWorkerUrl = new URL(
      "@thatopen/fragments/dist/Worker/worker.mjs",
      import.meta.url,
    );
    fragments.init(fragmentsWorkerUrl.href);

    fragments.onFragmentsLoaded.add((event) => {
      console.info("[Fragments] loaded", event);
    });

    components.get(OBC.Grids).create(world);

    // Camera initial position
    world.camera.controls.setLookAt(10, 10, 10, 0, 0, 0);
    world.camera.controls.fitToSphere(world.scene.three, true);

    // --- RENDER / UPDATE LOOP ---
    // Worlds (camera controls, renderer, fragments, etc) update via `worlds.update()`.
    // Without this, nothing will render.
    let lastTime = performance.now();
    const tick = (time) => {
      if (cancelled) return;
      const delta = (time - lastTime) / 1000;
      lastTime = time;
      worlds.update(delta);
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);

    const ifcLoader = components.get(OBC.IfcLoader);

    // Expose internals for debugging in DevTools console.
    // Example: `window.__obc.world.scene.three.children`
    window.__obc = {
      components,
      world,
      fragments,
      ifcLoader,
    };

    ifcLoader.settings.includeAll = true;
    ifcLoader.settings.optimization = false;

    const loadModel = async () => {
      try {
        console.groupCollapsed("[IFC] load start");
        console.info("crossOriginIsolated:", window.crossOriginIsolated);
        console.info("fragments worker:", fragmentsWorkerUrl.href);
        await logFetch("/web-ifc.wasm", "WASM");
        await logFetch("/web-ifc/A-40-V-000_BIM2BOM.ifc", "IFC");

        // IfcLoader expects `wasm.path/absolute` at the top level.
        // Use a locally-served WASM from /public to avoid CDN/network issues.
        await ifcLoader.setup({
          autoSetWasm: false,
          wasm: {
            path: "/",
            absolute: true,
          },
        });

        console.info("ifcLoader.settings.wasm:", ifcLoader.settings.wasm);

        const response = await fetch("/web-ifc/A-40-V-000_BIM2BOM.ifc");
        if (!response.ok) {
          throw new Error(
            `Failed to fetch IFC: ${response.status} ${response.statusText}`,
          );
        }

        const buffer = new Uint8Array(await response.arrayBuffer());

        const fragments = components.get(OBC.FragmentsManager);
        fragments.frustumCulling = false;

        console.info("IFC bytes:", buffer.byteLength);

        // Quick sanity check: IFC-SPF files typically start with ISO-10303-21.
        const header = new TextDecoder().decode(buffer.slice(0, 32));
        if (!header.includes("ISO-10303-21")) {
          throw new Error(
            `Fetched file doesn't look like an IFC (header: ${JSON.stringify(header)})`,
          );
        }

        const t0 = performance.now();

        // IMPORTANT: pass explicit defaults (this version doesn't default them).
        const model = await ifcLoader.load(buffer, true, "BIM2BOM");
        const t1 = performance.now();
        if (cancelled) return;

        console.info(`IfcLoader.load() done in ${(t1 - t0).toFixed(0)}ms`);
        console.info("Fragments models list:", [...fragments.list.keys()]);
        console.info("Model object:", model.object);
        console.info("Model children:", model.object?.children?.length);

        // Force Fragments to finish pending worker requests and build meshes.
        // Without this, `model.object` can remain empty (children = 0).
        await fragments.core.update(true);
        console.info(
          "Model children after update:",
          model.object?.children?.length,
        );

        world.scene.three.add(model.object);

        console.info("Scene children:", world.scene.three.children.length);

        // Optional: fit camera to model
        world.camera.controls.fitToSphere(model.object, true);

        // Don't recreate the renderer here; it can detach/replace the canvas
        // and make it look like "there is no renderer".
        console.info("Renderer canvas:", world.renderer?.three?.domElement);

        console.groupEnd();
      } catch (e) {
        console.error("IFC load failed", e);
        try {
          console.groupEnd();
        } catch {
          // ignore
        }
      }
    };

    void loadModel();

    // --- CLEANUP ---
    return () => {
      cancelled = true;
      if (rafId !== null) cancelAnimationFrame(rafId);
      components.dispose();
      componentsRef.current = null;
    };
  }, []);

  return (
    <div
      ref={containerRef}
      style={{
        width: "100vw",
        height: "100vh",
        overflow: "hidden",
      }}
    />
  );
}
